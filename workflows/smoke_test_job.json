{
  "name": "speech-analytics-smoke-test",
  "format": "MULTI_TASK",
  "parameters": [
    {
      "name": "catalog",
      "default": "main"
    },
    {
      "name": "schema",
      "default": "speech_analytics_dev"
    },
    {
      "name": "volume_root",
      "default": "/Volumes/main/speech_analytics_dev/speech_audio"
    }
  ],
  "git_source": {
    "git_url": "https://github.com/soulipaco/speechanalytics-databricks-pipeline.git",
    "git_provider": "gitHub",
    "git_branch": "main"
  },
  "job_clusters": [
    {
      "job_cluster_key": "smoke_cluster",
      "new_cluster": {
        "spark_version": "14.3.x-scala2.12",
        "node_type_id": "REPLACE_WITH_SMALL_NODE_TYPE",
        "num_workers": 1,
        "autotermination_minutes": 30
      }
    }
  ],
  "tasks": [
    {
      "task_key": "foundation_01_ingest_audio",
      "job_cluster_key": "smoke_cluster",
      "notebook_task": {
        "notebook_path": "notebooks/foundation/foundation_01_ingest_audio.py",
        "source": "GIT",
        "base_parameters": {
          "catalog": "{{job.parameters.catalog}}",
          "schema": "{{job.parameters.schema}}",
          "run_id": "{{job.run_id}}",
          "run_mode": "sample",
          "max_files_per_run": "5",
          "volume_root": "{{job.parameters.volume_root}}"
        }
      }
    },
    {
      "task_key": "foundation_02_preprocess_audio",
      "depends_on": [
        {
          "task_key": "foundation_01_ingest_audio"
        }
      ],
      "job_cluster_key": "smoke_cluster",
      "notebook_task": {
        "notebook_path": "notebooks/foundation/foundation_02_preprocess_audio.py",
        "source": "GIT",
        "base_parameters": {
          "catalog": "{{job.parameters.catalog}}",
          "schema": "{{job.parameters.schema}}",
          "volume_root": "{{job.parameters.volume_root}}",
          "run_id": "{{job.run_id}}",
          "run_mode": "sample",
          "max_files_per_run": "5",
          "enable_preprocess_audio": "false"
        }
      }
    },
    {
      "task_key": "foundation_03_diarize_audio",
      "depends_on": [
        {
          "task_key": "foundation_02_preprocess_audio"
        }
      ],
      "job_cluster_key": "smoke_cluster",
      "notebook_task": {
        "notebook_path": "notebooks/foundation/foundation_03_diarize_audio.py",
        "source": "GIT",
        "base_parameters": {
          "catalog": "{{job.parameters.catalog}}",
          "schema": "{{job.parameters.schema}}",
          "volume_root": "{{job.parameters.volume_root}}",
          "run_id": "{{job.run_id}}",
          "run_mode": "sample",
          "max_files_per_run": "5",
          "enable_diarization": "false"
        }
      }
    },
    {
      "task_key": "foundation_04_transcribe_audio",
      "depends_on": [
        {
          "task_key": "foundation_03_diarize_audio"
        }
      ],
      "job_cluster_key": "smoke_cluster",
      "notebook_task": {
        "notebook_path": "notebooks/foundation/foundation_04_transcribe_audio.py",
        "source": "GIT",
        "base_parameters": {
          "catalog": "{{job.parameters.catalog}}",
          "schema": "{{job.parameters.schema}}",
          "run_id": "{{job.run_id}}",
          "run_mode": "sample",
          "max_files_per_run": "5"
        }
      }
    },
    {
      "task_key": "foundation_05_align_turns",
      "depends_on": [
        {
          "task_key": "foundation_04_transcribe_audio"
        }
      ],
      "job_cluster_key": "smoke_cluster",
      "notebook_task": {
        "notebook_path": "notebooks/foundation/foundation_05_align_turns.py",
        "source": "GIT",
        "base_parameters": {
          "catalog": "{{job.parameters.catalog}}",
          "schema": "{{job.parameters.schema}}",
          "run_id": "{{job.run_id}}",
          "run_mode": "sample",
          "max_files_per_run": "5"
        }
      }
    },
    {
      "task_key": "foundation_06_redact_pii",
      "depends_on": [
        {
          "task_key": "foundation_05_align_turns"
        }
      ],
      "job_cluster_key": "smoke_cluster",
      "notebook_task": {
        "notebook_path": "notebooks/foundation/foundation_06_redact_pii.py",
        "source": "GIT",
        "base_parameters": {
          "catalog": "{{job.parameters.catalog}}",
          "schema": "{{job.parameters.schema}}",
          "run_id": "{{job.run_id}}",
          "run_mode": "sample",
          "max_files_per_run": "5"
        }
      }
    },
    {
      "task_key": "foundation_07_translate_turns",
      "depends_on": [
        {
          "task_key": "foundation_06_redact_pii"
        }
      ],
      "job_cluster_key": "smoke_cluster",
      "notebook_task": {
        "notebook_path": "notebooks/foundation/foundation_07_translate_turns.py",
        "source": "GIT",
        "base_parameters": {
          "catalog": "{{job.parameters.catalog}}",
          "schema": "{{job.parameters.schema}}",
          "run_id": "{{job.run_id}}",
          "run_mode": "sample",
          "max_files_per_run": "5",
          "enable_translation": "false"
        }
      }
    },
    {
      "task_key": "foundation_08_publish_and_finalize",
      "depends_on": [
        {
          "task_key": "foundation_07_translate_turns"
        }
      ],
      "job_cluster_key": "smoke_cluster",
      "notebook_task": {
        "notebook_path": "notebooks/foundation/foundation_08_publish_and_finalize.py",
        "source": "GIT",
        "base_parameters": {
          "catalog": "{{job.parameters.catalog}}",
          "schema": "{{job.parameters.schema}}",
          "run_id": "{{job.run_id}}",
          "run_mode": "sample",
          "max_files_per_run": "5",
          "publish_latest_views": "false"
        }
      }
    },
    {
      "task_key": "insights_01_compute_conversation_metrics",
      "depends_on": [
        {
          "task_key": "foundation_08_publish_and_finalize"
        }
      ],
      "job_cluster_key": "smoke_cluster",
      "notebook_task": {
        "notebook_path": "notebooks/insights/insights_01_compute_conversation_metrics.py",
        "source": "GIT",
        "base_parameters": {
          "catalog": "{{job.parameters.catalog}}",
          "schema": "{{job.parameters.schema}}",
          "run_id": "{{job.run_id}}",
          "run_mode": "sample",
          "max_files_per_run": "5"
        }
      }
    },
    {
      "task_key": "insights_02_load_taxonomies_to_dim_tables",
      "depends_on": [
        {
          "task_key": "insights_01_compute_conversation_metrics"
        }
      ],
      "job_cluster_key": "smoke_cluster",
      "notebook_task": {
        "notebook_path": "notebooks/insights/insights_02_load_taxonomies_to_dim_tables.py",
        "source": "GIT",
        "base_parameters": {
          "catalog": "{{job.parameters.catalog}}",
          "schema": "{{job.parameters.schema}}",
          "run_id": "{{job.run_id}}",
          "run_mode": "sample",
          "max_files_per_run": "5"
        }
      }
    },
    {
      "task_key": "insights_03_build_text_chunks",
      "depends_on": [
        {
          "task_key": "insights_02_load_taxonomies_to_dim_tables"
        }
      ],
      "job_cluster_key": "smoke_cluster",
      "notebook_task": {
        "notebook_path": "notebooks/insights/insights_03_build_text_chunks.py",
        "source": "GIT",
        "base_parameters": {
          "catalog": "{{job.parameters.catalog}}",
          "schema": "{{job.parameters.schema}}",
          "run_id": "{{job.run_id}}",
          "run_mode": "sample",
          "max_files_per_run": "5",
          "translation_enabled": "false"
        }
      }
    },
    {
      "task_key": "insights_04_embed_chunks",
      "depends_on": [
        {
          "task_key": "insights_03_build_text_chunks"
        }
      ],
      "job_cluster_key": "smoke_cluster",
      "notebook_task": {
        "notebook_path": "notebooks/insights/insights_04_embed_chunks.py",
        "source": "GIT",
        "base_parameters": {
          "catalog": "{{job.parameters.catalog}}",
          "schema": "{{job.parameters.schema}}",
          "run_id": "{{job.run_id}}",
          "run_mode": "sample",
          "max_files_per_run": "5",
          "enable_embeddings": "false"
        }
      }
    },
    {
      "task_key": "insights_05_build_vector_search_rag_index",
      "depends_on": [
        {
          "task_key": "insights_04_embed_chunks"
        }
      ],
      "job_cluster_key": "smoke_cluster",
      "notebook_task": {
        "notebook_path": "notebooks/insights/insights_05_build_vector_search_rag_index.py",
        "source": "GIT",
        "base_parameters": {
          "catalog": "{{job.parameters.catalog}}",
          "schema": "{{job.parameters.schema}}",
          "run_id": "{{job.run_id}}",
          "run_mode": "sample",
          "max_files_per_run": "5",
          "enable_rag_index": "false"
        }
      }
    },
    {
      "task_key": "insights_06_llm_extract_chunk_insights",
      "depends_on": [
        {
          "task_key": "insights_05_build_vector_search_rag_index"
        }
      ],
      "job_cluster_key": "smoke_cluster",
      "notebook_task": {
        "notebook_path": "notebooks/insights/insights_06_llm_extract_chunk_insights.py",
        "source": "GIT",
        "base_parameters": {
          "catalog": "{{job.parameters.catalog}}",
          "schema": "{{job.parameters.schema}}",
          "run_id": "{{job.run_id}}",
          "run_mode": "sample",
          "max_files_per_run": "5",
          "enable_llm": "false"
        }
      }
    },
    {
      "task_key": "insights_07_llm_consolidate_call_insights",
      "depends_on": [
        {
          "task_key": "insights_06_llm_extract_chunk_insights"
        }
      ],
      "job_cluster_key": "smoke_cluster",
      "notebook_task": {
        "notebook_path": "notebooks/insights/insights_07_llm_consolidate_call_insights.py",
        "source": "GIT",
        "base_parameters": {
          "catalog": "{{job.parameters.catalog}}",
          "schema": "{{job.parameters.schema}}",
          "run_id": "{{job.run_id}}",
          "run_mode": "sample",
          "max_files_per_run": "5",
          "enable_llm_consolidation": "false"
        }
      }
    },
    {
      "task_key": "insights_08_quality_gates_and_finalize",
      "depends_on": [
        {
          "task_key": "insights_07_llm_consolidate_call_insights"
        }
      ],
      "job_cluster_key": "smoke_cluster",
      "notebook_task": {
        "notebook_path": "notebooks/insights/insights_08_quality_gates_and_finalize.py",
        "source": "GIT",
        "base_parameters": {
          "catalog": "{{job.parameters.catalog}}",
          "schema": "{{job.parameters.schema}}",
          "run_id": "{{job.run_id}}",
          "run_mode": "sample",
          "max_files_per_run": "5",
          "allow_warn": "true"
        }
      }
    }
  ],
  "description": "Git-source template for the public repository. Override catalog, schema, and volume_root together for the target environment. Keep secret values in Databricks secret scopes, not in this file."
}
